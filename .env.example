# Database
DATABASE_URL=postgresql://cowork:cowork@localhost:5432/cowork

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# GitHub (read-only PAT)
GITHUB_TOKEN=ghp_...

# Render API (read-only)
RENDER_API_KEY=rnd_...

# Auth — generate with: node -e "const bcrypt=require('bcryptjs');console.log(bcrypt.hashSync('yourpassword',12))"
COWORK_PASSWORD_HASH=$2b$12$...

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
COWORK_JWT_SECRET=hex64chars...

# Daemon auth token — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COWORK_DAEMON_TOKEN=hex32chars...

# App
NODE_ENV=development
PORT=3000
HQ_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
